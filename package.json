{
  "name": "salon-pos",
  "version": "1.0.0",
  "private": true,
  "author": "MH Digital",
  "main": "app/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "dist": "vite build && electron-builder --win",
    "react:dev": "vite",
    "react:build": "vite build",
    "react:preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "dexie": "^4.0.1",
    "dexie-react-hooks": "^1.1.7",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.321.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.28.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.mhdigital.salonpos",
    "productName": "Salon POS",
    "copyright": "Copyright © 2026 MH Digital",
    "files": ["app/electron/**/*", "dist/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
